<%@ Master Language="C#" AutoEventWireup="true"
    CodeBehind="DashboardMaster.master.cs"
    Inherits="BWDMS.Master.DashboardMaster" %>

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">

<head runat="server">

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        <asp:ContentPlaceHolder ID="TitleContent"
            runat="server">
            BWDMS
        </asp:ContentPlaceHolder>
    </title>


    <!-- Bootstrap CSS -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
          rel="stylesheet" />


    <!-- Bootstrap Icons -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css"
          rel="stylesheet" />


    <!-- Dashboard CSS -->

    <link href="<%= ResolveUrl("~/Content/Dashboard.css") %>"
          rel="stylesheet" />


    <!-- Page-specific Head Content -->

    <asp:ContentPlaceHolder ID="HeadContent"
        runat="server">
    </asp:ContentPlaceHolder>

</head>


<body>

<form id="form1" runat="server">


    <!-- =====================================================
         HEADER
         ===================================================== -->

    <header class="top-header">


        <!-- LEFT SIDE -->

        <div class="header-left">

            <button type="button"
                    class="sidebar-toggle"
                    id="sidebarToggle">

                <i class="bi bi-list"></i>

            </button>


            <span class="page-brand">
                BWDMS
            </span>

        </div>


        <!-- RIGHT SIDE -->

        <div class="header-right">


            <!-- Notification -->

            <div class="notification">

                <i class="bi bi-bell"></i>

                <span class="notification-badge">
                    0
                </span>

            </div>


            <!-- User -->

            <div class="user-info">


                <div class="user-avatar">

                    <asp:Label
                        ID="lblUserInitial"
                        runat="server">

                        U

                    </asp:Label>

                </div>


                <div class="user-details">

                    <strong>

                        <asp:Label
                            ID="lblUserName"
                            runat="server">

                            User

                        </asp:Label>

                    </strong>


                    <small>

                        <asp:Label
                            ID="lblUserRole"
                            runat="server">

                            User

                        </asp:Label>

                    </small>

                </div>

            </div>

        </div>

    </header>



    <!-- =====================================================
         SIDEBAR
         ===================================================== -->

    <aside class="sidebar"
           id="sidebar">


        <!-- SIDEBAR LOGO -->

        <div class="sidebar-logo">


            <div class="logo-icon">

                BW

            </div>


            <div>

                <strong>
                    BWDMS
                </strong>

                <small>
                    Dealer Management
                </small>

            </div>

        </div>



        <!-- SIDEBAR MENU -->

        <div class="sidebar-menu">


            <!-- =================================================
                 COMMON DASHBOARD
                 ================================================= -->

            <div class="menu-title">

                MAIN MENU

            </div>


            <asp:HyperLink
                ID="lnkDashboard"
                runat="server"
                CssClass="menu-item"
                NavigateUrl="#">

                <i class="bi bi-grid-1x2-fill"></i>

                <span>
                    Dashboard
                </span>

            </asp:HyperLink>



            <!-- =================================================
                 ADMIN MENU
                 ================================================= -->

            <asp:Panel
                ID="pnlAdminMenu"
                runat="server"
                Visible="false">


                <div class="menu-title">

                    MANAGEMENT

                </div>


                <asp:HyperLink
                    ID="lnkAdminCategories"
                    runat="server"
                    CssClass="menu-item"
                    NavigateUrl="#">

                    <i class="bi bi-tags-fill"></i>

                    <span>
                        Categories
                    </span>

                </asp:HyperLink>


                <asp:HyperLink
                    ID="lnkAdminProducts"
                    runat="server"
                    CssClass="menu-item"
                    NavigateUrl="#">

                    <i class="bi bi-box-seam-fill"></i>

                    <span>
                        Products
                    </span>

                </asp:HyperLink>


               <asp:HyperLink
                ID="lnkAdminDealers"
                runat="server"
                CssClass="menu-item"
                NavigateUrl="~/Admin/Dealers.aspx">

                <i class="bi bi-shop"></i>

                <span>
                    Dealers
                </span>

            </asp:HyperLink>


                <asp:HyperLink
                    ID="lnkAdminUsers"
                    runat="server"
                    CssClass="menu-item"
                    NavigateUrl="#">

                    <i class="bi bi-people-fill"></i>

                    <span>
                        Users
                    </span>

                </asp:HyperLink>


                <div class="menu-title">

                    REPORTS

                </div>


                <asp:HyperLink
                    ID="lnkAdminOrders"
                    runat="server"
                    CssClass="menu-item"
                    NavigateUrl="#">

                    <i class="bi bi-cart-check"></i>

                    <span>
                        Orders
                    </span>

                </asp:HyperLink>


                <asp:HyperLink
                    ID="lnkAdminReports"
                    runat="server"
                    CssClass="menu-item"
                    NavigateUrl="#">

                    <i class="bi bi-bar-chart-fill"></i>

                    <span>
                        Reports
                    </span>

                </asp:HyperLink>


                <div class="menu-title">

                    SYSTEM

                </div>


                <asp:HyperLink
                    ID="lnkAdminSettings"
                    runat="server"
                    CssClass="menu-item"
                    NavigateUrl="#">

                    <i class="bi bi-gear-fill"></i>

                    <span>
                        Settings
                    </span>

                </asp:HyperLink>

            </asp:Panel>



            <!-- =================================================
                 DEALER MENU
                 ================================================= -->

            <asp:Panel
                ID="pnlDealerMenu"
                runat="server"
                Visible="false">


                <div class="menu-title">

                    MANAGEMENT

                </div>

                <asp:HyperLink
                    ID="lnkDealerRoutes"
                    runat="server"
                    CssClass="menu-item"
                    NavigateUrl="~/Dealer/Routes.aspx">

                    <i class="bi bi-signpost-2"></i>

                    <span>
                        Routes
                    </span>

                </asp:HyperLink>

                <asp:HyperLink
                    ID="lnkDealerVillages"
                    runat="server"
                    CssClass="menu-item"
                    NavigateUrl="~/Dealer/Villages.aspx">

                    <i class="bi bi-geo-alt"></i>

                    <span>Villages</span>

                </asp:HyperLink>

                
                <asp:HyperLink
                    ID="lnkWeeklyRoutePlans"
                    runat="server"
                    CssClass="menu-item"
                    NavigateUrl="~/Dealer/RouteSchedules.aspx">

                    <i class="bi bi-calendar-week"></i>

                    <span>Weekly Plans</span>

                </asp:HyperLink>
                <!-- Shops -->

                <asp:HyperLink
                    ID="lnkDealerShops"
                    runat="server"
                    CssClass="menu-item"
                    NavigateUrl="#">

                    <i class="bi bi-shop"></i>

                    <span>
                        Shops
                    </span>

                </asp:HyperLink>


                <!-- Salesmen -->

                <asp:HyperLink
                    ID="lnkDealerSalesmen"
                    runat="server"
                    CssClass="menu-item"
                    NavigateUrl="#">

                    <i class="bi bi-people"></i>

                    <span>
                        Salesmen
                    </span>

                </asp:HyperLink>


                <!-- Vehicles -->

                <asp:HyperLink
                    ID="lnkDealerVehicles"
                    runat="server"
                    CssClass="menu-item"
                    NavigateUrl="#">

                    <i class="bi bi-truck"></i>

                    <span>
                        Vehicles
                    </span>

                </asp:HyperLink>


                <!-- Inventory -->

                <asp:HyperLink
                    ID="lnkDealerInventory"
                    runat="server"
                    CssClass="menu-item"
                    NavigateUrl="#">

                    <i class="bi bi-box-seam"></i>

                    <span>
                        Inventory
                    </span>

                </asp:HyperLink>


                <!-- Orders -->

                <asp:HyperLink
                    ID="lnkDealerOrders"
                    runat="server"
                    CssClass="menu-item"
                    NavigateUrl="#">

                    <i class="bi bi-cart-check"></i>

                    <span>
                        Orders
                    </span>

                </asp:HyperLink>


                <div class="menu-title">

                    OPERATIONS

                </div>


                <!-- Stock Reconciliation -->

                <asp:HyperLink
                    ID="lnkDealerReconciliation"
                    runat="server"
                    CssClass="menu-item"
                    NavigateUrl="#">

                    <i class="bi bi-arrow-repeat"></i>

                    <span>
                        Stock Reconciliation
                    </span>

                </asp:HyperLink>


                <!-- Reports -->

                <asp:HyperLink
                    ID="lnkDealerReports"
                    runat="server"
                    CssClass="menu-item"
                    NavigateUrl="#">

                    <i class="bi bi-bar-chart"></i>

                    <span>
                        Reports
                    </span>

                </asp:HyperLink>


                <div class="menu-title">

                    SYSTEM

                </div>


                <asp:HyperLink
                    ID="lnkDealerSettings"
                    runat="server"
                    CssClass="menu-item"
                    NavigateUrl="#">

                    <i class="bi bi-gear"></i>

                    <span>
                        Settings
                    </span>

                </asp:HyperLink>

            </asp:Panel>



            <!-- =================================================
                 SALESMAN MENU
                 ================================================= -->

            <asp:Panel
                ID="pnlSalesmanMenu"
                runat="server"
                Visible="false">


                <div class="menu-title">

                    MAIN MENU

                </div>


                <asp:HyperLink
                    ID="lnkSalesmanShops"
                    runat="server"
                    CssClass="menu-item"
                    NavigateUrl="#">

                    <i class="bi bi-shop"></i>

                    <span>
                        My Shops
                    </span>

                </asp:HyperLink>


                <asp:HyperLink
                    ID="lnkSalesmanRoutes"
                    runat="server"
                    CssClass="menu-item"
                    NavigateUrl="#">

                    <i class="bi bi-map"></i>

                    <span>
                        Routes / Beats
                    </span>

                </asp:HyperLink>


                <asp:HyperLink
                    ID="lnkSalesmanCreateOrder"
                    runat="server"
                    CssClass="menu-item"
                    NavigateUrl="#">

                    <i class="bi bi-cart-plus"></i>

                    <span>
                        Create Order
                    </span>

                </asp:HyperLink>


                <asp:HyperLink
                    ID="lnkSalesmanOrders"
                    runat="server"
                    CssClass="menu-item"
                    NavigateUrl="#">

                    <i class="bi bi-cart-check"></i>

                    <span>
                        My Orders
                    </span>

                </asp:HyperLink>


                <asp:HyperLink
                    ID="lnkSalesmanStock"
                    runat="server"
                    CssClass="menu-item"
                    NavigateUrl="#">

                    <i class="bi bi-box-seam"></i>

                    <span>
                        Vehicle Stock
                    </span>

                </asp:HyperLink>


                <div class="menu-title">

                    OPERATIONS

                </div>


                <asp:HyperLink
                    ID="lnkSalesmanCollection"
                    runat="server"
                    CssClass="menu-item"
                    NavigateUrl="#">

                    <i class="bi bi-cash-stack"></i>

                    <span>
                        Collection
                    </span>

                </asp:HyperLink>


                <asp:HyperLink
                    ID="lnkSalesmanReports"
                    runat="server"
                    CssClass="menu-item"
                    NavigateUrl="#">

                    <i class="bi bi-bar-chart"></i>

                    <span>
                        Reports
                    </span>

                </asp:HyperLink>

            </asp:Panel>

        </div>



        <!-- =====================================================
             LOGOUT
             ===================================================== -->

        <div class="sidebar-bottom">

            <asp:LinkButton
                ID="btnLogout"
                runat="server"
                CssClass="logout-button"
                OnClick="btnLogout_Click">

                <i class="bi bi-box-arrow-right"></i>

                <span>
                    Logout
                </span>

            </asp:LinkButton>

        </div>

    </aside>



    <!-- =====================================================
         MAIN CONTENT
         ===================================================== -->

    <main class="main-content"
          id="mainContent">

        <asp:ContentPlaceHolder
            ID="MainContent"
            runat="server">

        </asp:ContentPlaceHolder>

    </main>



    <!-- =====================================================
         FOOTER
         ===================================================== -->

    <footer class="dashboard-footer">

        <span>
            © 2026 BWDMS. All Rights Reserved.
        </span>


        <span>
            Balaji Wafers Dealer Management System
        </span>

    </footer>



    <!-- =====================================================
         BOOTSTRAP JS
         ===================================================== -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js">
    </script>


    <!-- =====================================================
         DASHBOARD JS
         ===================================================== -->

    <script src="<%= ResolveUrl("~/Scripts/Dashboard.js") %>">
    </script>


</form>

</body>

</html>