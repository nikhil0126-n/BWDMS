<?xml version="1.0" encoding="utf-8"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  https://go.microsoft.com/fwlink/?LinkId=169433
  -->
<configuration>
  <system.web>
    <compilation debug="true" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" />
    <!--
      SESSION STATE
      InProc with a real (non-URL-rewritten) cookie and a 30 minute
      idle timeout. 30 minutes matches the shift length of a dealer /
      salesman user without keeping abandoned sessions around for
      hours. cookieless="UseCookies" keeps the session id out of the
      URL (a URL-borne session id leaks through history, logs and the
      Referer header).
      An expired session simply leaves Session["UserId"] null, and the
      existing page-level guard in DashboardMaster.master.cs and in
      every protected page redirects the user to Account/Login.aspx -
      no extra timeout handler is needed or wanted.
    -->
    <sessionState mode="InProc" timeout="30" cookieless="UseCookies" />
    <!--
      ERROR HANDLING
      RemoteOnly: developers still get the detailed ASP.NET error on
      localhost, everyone else gets the friendly, information-safe
      Error.aspx (no exception details, no stack traces, no connection
      strings - in any mode).
      redirectMode="ResponseRewrite" renders the error page in place
      so the original HTTP status code (404 / 500) is preserved
      instead of being replaced by a 302 to a 200 page.
      Unhandled exceptions are first recorded by
      Global.Application_Error to App_Data\AppLog.txt.
    -->
    <customErrors mode="RemoteOnly" defaultRedirect="~/Error.aspx" redirectMode="ResponseRewrite">
      <error statusCode="404" redirect="~/Error.aspx" />
      <error statusCode="500" redirect="~/Error.aspx" />
    </customErrors>
    <!--
      COOKIES
      httpOnlyCookies: the session cookie cannot be read from
      JavaScript, which blunts XSS session theft.
      requireSSL stays FALSE here on purpose: local development and the
      verification server both run over plain http, and requireSSL="true"
      would make the browser drop the session cookie immediately.
      Web.Release.config flips requireSSL to "true", so an HTTPS
      deployment is HTTPS-ready without breaking localhost.
    -->
    <httpCookies httpOnlyCookies="true" requireSSL="false" />
  </system.web>
  <system.codedom>
    <compilers>
      <compiler language="c#;cs;csharp" extension=".cs" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.CSharpCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:1659;1699;1701" />
      <compiler language="vb;vbs;visualbasic;vbscript" extension=".vb" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.VBCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:41008 /define:_MYTYPE=\&quot;Web\&quot; /optionInfer+" />
    </compilers>
  </system.codedom>
	<connectionStrings>
		<add name="Database1"
			 connectionString="Data Source=(LocalDB)\MSSQLLocalDB;AttachDbFilename=|DataDirectory|\Database1.mdf;Integrated Security=True"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>
	<appSettings>
		<add key="ValidationSettings:UnobtrusiveValidationMode"
			 value="None" />
	</appSettings>
	<system.webServer>
		<!-- Always revalidate CSS/JS so layout changes are never served stale. -->
		<staticContent>
			<clientCache cacheControlMode="DisableCache" />
		</staticContent>
		<!--
		  FINAL ERROR SAFETY NET
		  <customErrors mode="RemoteOnly"> intentionally shows the
		  detailed ASP.NET error page to LOCAL clients (that is what
		  RemoteOnly means). This IIS rule closes that gap: a 404 or a
		  500 is always answered by the same information-safe
		  Error.aspx, for local and remote clients alike, while the
		  original status code and the Application_Error log entry are
		  preserved. responseMode="ExecuteURL" renders the page inside
		  the request (no 302 redirect), so the browser keeps the URL.
		-->
		<httpErrors existingResponse="Replace">
			<!-- Drop the inherited IIS default entries before redefining them,
			     otherwise IIS reports 500.19 "duplicate collection entry". -->
			<remove statusCode="404" subStatusCode="-1" />
			<remove statusCode="500" subStatusCode="-1" />
			<error statusCode="404" path="/Error.aspx" responseMode="ExecuteURL" />
			<error statusCode="500" path="/Error.aspx" responseMode="ExecuteURL" />
		</httpErrors>
	</system.webServer>
</configuration>
